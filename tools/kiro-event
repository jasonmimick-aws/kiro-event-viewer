#!/usr/bin/env python3
"""Post an event to the Kiro Event Viewer's Application log.

    kiro-event --source nightly-backup --level warning "Backup took 41 minutes"
    kiro-event -s deploy -l error -c Release -i 1001 "Deploy failed" --data '{"pr": 812}'
    echo "disk at 91%" | kiro-event -s disk-watch -l warning -

Writes one JSON line into the app's owner-only inbox directory and renames it
into place atomically, so the viewer never reads a half-written event. No
network, no credentials: the inbox's file permissions are the access control.

Levels: information (default), warning, error, success, failure.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import uuid
from pathlib import Path

LEVELS = ("information", "info", "warning", "warn", "error", "success", "failure")


def inbox_dir() -> Path:
    env = os.environ.get("KIRO_EVENT_INBOX")
    if env:
        return Path(env)
    home = Path(os.environ.get("KIROCREW_HOME") or Path.home() / ".kiro" / "crew")
    return home / "apps" / "kiro-event-viewer" / "data" / "inbox"


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="kiro-event", description="Post an event to the Kiro Event Viewer.")
    ap.add_argument("message", help="event text, or - to read it from stdin")
    ap.add_argument("-s", "--source", required=True, help="who is reporting (a service or script name)")
    ap.add_argument("-l", "--level", default="information", choices=LEVELS)
    ap.add_argument("-c", "--category", default="", help="free-form category, e.g. Backup")
    ap.add_argument("-i", "--event-id", type=int, default=0, help="numeric event id, 0-65535")
    ap.add_argument("--data", default=None, help="extra JSON object shown in the event's details")
    args = ap.parse_args(argv)

    message = sys.stdin.read().strip() if args.message == "-" else args.message
    if not message:
        ap.error("message is empty")
    data = None
    if args.data:
        try:
            data = json.loads(args.data)
        except json.JSONDecodeError as exc:
            ap.error(f"--data is not valid JSON: {exc}")

    event = {"source": args.source, "level": args.level, "category": args.category,
             "event_id": args.event_id, "message": message, "ts": time.time()}
    if data is not None:
        event["data"] = data

    inbox = inbox_dir()
    if not inbox.is_dir():
        print(f"kiro-event: {inbox} does not exist. Is the Kiro Event Viewer app installed and enabled?",
              file=sys.stderr)
        return 2
    name = f"{int(time.time() * 1000)}-{uuid.uuid4().hex[:8]}"
    tmp = inbox / f".{name}.tmp"
    tmp.write_text(json.dumps(event, ensure_ascii=False) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    tmp.replace(inbox / f"{name}.jsonl")
    return 0


if __name__ == "__main__":
    sys.exit(main())
